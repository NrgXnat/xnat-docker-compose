# Published XNAT image. For XNAT 1.9, use XNAT_IMAGE=ghcr.io/nrgxnat/xnat-web and XNAT_VERSION=1.9.3.9.
XNAT_IMAGE=ghcr.io/nrgxnat/xnat
XNAT_VERSION=1.10.2.1
# User XNAT runs as. On Linux, set it to your own uid (id -u) so XNAT can write the
# directories mounted from this folder. Leave it at 1000 on Docker Desktop.
XNAT_UID=1000
# Group that owns the Docker socket, so XNAT can use it for the container service.
# 0 on Docker Desktop. On Linux: stat -c %g /var/run/docker.sock
DOCKER_GID=0
PG_VERSION=16.15-alpine
NGINX_VERSION=1.30.6-alpine-perl

XNAT_MIN_HEAP=256m
XNAT_MAX_HEAP=4g
XNAT_SMTP_ENABLED=false
XNAT_SMTP_HOSTNAME=fake.fake
XNAT_SMTP_PORT=
XNAT_SMTP_AUTH=
XNAT_SMTP_USERNAME=
XNAT_SMTP_PASSWORD=
XNAT_SMTP_START_TLS=
XNAT_DATASOURCE_ADMIN_PASSWORD=xnat123456789abcdef0
XNAT_DATASOURCE_DRIVER=org.postgresql.Driver
XNAT_DATASOURCE_NAME=xnat
XNAT_DATASOURCE_USERNAME=xnat
XNAT_DATASOURCE_PASSWORD=xnat
XNAT_DATASOURCE_URL=jdbc:postgresql://xnat-db/xnat
XNAT_ACTIVEMQ_URL=
XNAT_ACTIVEMQ_USERNAME=write
XNAT_ACTIVEMQ_PASSWORD=password
ACTIVEMQ_VERSION=6.2.0
XNAT_ROOT=/data/xnat
XNAT_EMAIL=harmitage@miskatonic.edu
# Time zone for XNAT, as a tz database name such as America/Chicago.
XNAT_TZ=Etc/UTC

# ---- Multi-node cluster (optional) ----
# To run 2x xnat-web load-balanced with an external ActiveMQ broker, set the three
# values below and run:  docker compose up -d
#   COMPOSE_PROFILES=multinode
#   NGINX_CONF=nginx-multinode.conf
#   XNAT_ACTIVEMQ_URL=tcp://xnat-activemq:61616
COMPOSE_PROFILES=
NGINX_CONF=nginx.conf

